# Copy this file to .env and supply values locally.
# Never commit .env or real credentials.

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL runtime login. It must be able to assume commitmentops_app.
# A direct username is the PostgreSQL role. A Supabase Session Pooler username
# has the form <role>.<project-ref> and is accepted only when <project-ref>
# matches SUPABASE_URL. The role is still refused when it is privileged.
DATABASE_URL=

# Privileged Alembic login (superuser or CREATEROLE). Required when DATABASE_URL
# is the restricted runtime login. Empty is valid for SQLite and for a local
# PostgreSQL login that already has those privileges. Alembic refuses an
# underprivileged login before it changes the schema.
MIGRATION_DATABASE_URL=

# Optional. Used only by PostgreSQL integration tests, never as a fallback
# from DATABASE_URL. Leave this empty in Git.
TEST_DATABASE_URL=

# Supabase Auth JWT verification (public metadata; no signing keys).
AUTH_ISSUER=
AUTH_AUDIENCE=authenticated
# Production requires an absolute https:// URL. Do not put a signing key here.
AUTH_JWKS_URL=

# Supabase Auth for the browser. The anon key is publishable.
# The service-role key is server-only and is not used by the interface.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider — required later for structured extraction and recommendations.
# Leave blank until that integration is implemented.
LLM_API_KEY=
LLM_API_BASE_URL=

# Private evidence files in Supabase Storage, reached through its
# S3-compatible endpoint. Create the private bucket and the S3 access keys
# in the Supabase dashboard. This application does not create the bucket
# and does not configure credentials.
#
# Supabase-generated S3 access keys bypass Storage RLS. They can read and
# write every bucket in the project. They are not bucket-scoped credentials.
# Do not copy SUPABASE_SERVICE_ROLE_KEY into either S3 field.
#
# The application login cannot run evidence cleanup. Do not schedule the
# cleanup worker on that connection, and do not run more than one worker.
# EVIDENCE_MAX_BYTES must stay at 10 MiB. A different value fails closed.
EVIDENCE_STORAGE_ENDPOINT=
EVIDENCE_STORAGE_REGION=
EVIDENCE_STORAGE_BUCKET=
EVIDENCE_STORAGE_ACCESS_KEY_ID=
EVIDENCE_STORAGE_SECRET_ACCESS_KEY=
EVIDENCE_MAX_BYTES=10485760
